# 使用说明：复制本文件为 keystore/signing.properties（该文件已被 .gitignore），
# 填入你的真实签名信息。构建脚本会在 app/build.gradle.kts 读取。
# 密码也可改用环境变量：RELEASE_STORE_FILE / RELEASE_STORE_PASSWORD / RELEASE_KEY_ALIAS / RELEASE_KEY_PASSWORD
# storeFile 为相对项目根（eareyereading/）的路径
storeFile=keystore/eareyereading-release.jks
storePassword=你的keystore密码
keyAlias=eareyereading
keyPassword=你的key密码
