<?xml version="1.0" encoding="utf-8"?>
<!--
  听阅 — 启动图 Splash（Android 12+）
  ============================================================
  设计原则：
  - 图标本体透明（无背景方块、无圆角矩形）
  - 主体内容（声波 + 立体书）直接居中画在 240×240 viewport 中央
  - 整屏背景由 windowSplashScreenBackground 提供（themes.xml 中设为暖白 #FBF8F3）
  - 视觉效果：暖白底 + 居中墨绿图标，无任何"色块"
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">

    <!--
      用 group 平移把 200×200 主体内容居中放进 240×240 viewport：
        (240 - 200) / 2 = 20
      主体内容在内部坐标系 (0,0)~(200,200) 描述，平移后落在 (20,20)~(220,220)
    -->
    <group android:translateX="20" android:translateY="20">

        <!-- 上方声波：4 个完整波周期 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#0E6B5E"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:pathData="M 20,62 C 26,42 34,42 40,62 C 46,82 54,82 60,62 C 66,42 74,42 80,62 C 86,82 94,82 100,62 C 106,42 114,42 120,62 C 126,82 134,82 140,62 C 146,42 154,42 160,62 C 166,82 174,82 180,62" />

        <!-- 立体书：左页 -->
        <path
            android:fillColor="#0E6B5E"
            android:pathData="M 100,88 L 35,98 L 30,108 L 30,158 L 100,170 Z" />

        <!-- 立体书：右页 -->
        <path
            android:fillColor="#0E6B5E"
            android:pathData="M 100,88 L 165,98 L 170,108 L 170,158 L 100,170 Z" />

        <!-- 左页厚度（侧面） -->
        <path
            android:fillColor="#0E6B5E"
            android:fillAlpha="0.55"
            android:pathData="M 30,158 L 35,168 L 100,180 L 100,170 Z" />

        <!-- 右页厚度（侧面） -->
        <path
            android:fillColor="#0E6B5E"
            android:fillAlpha="0.55"
            android:pathData="M 170,158 L 165,168 L 100,180 L 100,170 Z" />

        <!-- 书脊（与主体同色，无视觉书脊线，更通透） -->
        <path
            android:fillColor="#0E6B5E"
            android:pathData="M 98,88 L 102,88 L 102,170 L 98,170 Z" />

        <!-- 左侧文字行（白色横线，在墨绿书页上浮现） -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#F1FCFA"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M 42,118 L 88,115" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#F1FCFA"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M 42,132 L 80,129" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#F1FCFA"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M 42,146 L 86,143" />

        <!-- 右侧文字行 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#F1FCFA"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M 112,115 L 158,118" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#F1FCFA"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M 120,129 L 158,132" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#F1FCFA"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M 114,143 L 158,146" />
    </group>
</vector>
