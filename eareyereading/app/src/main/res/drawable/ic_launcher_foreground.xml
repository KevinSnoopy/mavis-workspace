<?xml version="1.0" encoding="utf-8"?>
<!--
  听阅 — Adaptive Icon 前景层
  概念「眸中之页」：两片书页合成杏仁眼廓，
  中缝 3.2dp 为书脊，中心瞳孔直径 12dp（精修去「大瞳孔」感）。

  安全区：内容落在中心 72dp 安全圆内（x 24→84, y 31→75），
  可承受圆形 / 圆角方形 / 水滴 / 花瓣等任意厂商遮罩裁切。

  瞳孔色 #0D594F = 背景渐变在中心点的取值，
  因此视觉上等同于「挖空透底」，无需 clip-path。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 左页：杏仁左半弧 + 书脊侧直边 -->
    <path
        android:fillColor="#F1FCFA"
        android:pathData="M54,31 C42,31 24,39.5 24,53 C24,66.5 42,75 54,75 L52.4,75 L52.4,31 Z"/>

    <!-- 右页：镜像 -->
    <path
        android:fillColor="#F1FCFA"
        android:pathData="M54,31 C66,31 84,39.5 84,53 C84,66.5 66,75 54,75 L55.6,75 L55.6,31 Z"/>

    <!-- 瞳孔：Android VectorDrawable 无 <circle>，以双弧路径表达 -->
    <path
        android:fillColor="#0D594F"
        android:pathData="M48,53 A6,6 0 1,1 60,53 A6,6 0 1,1 48,53 Z"/>
</vector>
