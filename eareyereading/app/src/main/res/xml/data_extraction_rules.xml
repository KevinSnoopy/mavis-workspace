<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ 备份/设备迁移规则。
     云备份与设备间迁移都排除可重新下载的资产（语音模型、词典），
     用户数据（Room 库、设置、导入的 books/）保留 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="sherpa_tts_models/" />
        <exclude domain="file" path="dictionaries/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="sherpa_tts_models/" />
        <exclude domain="file" path="dictionaries/" />
    </device-transfer>
</data-extraction-rules>
